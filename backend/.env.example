# Tri Zvezdy Avto Maktab — Backend sozlamalari

# Xavfsizlik (productionda albatta o'zgartiring)
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,tri-zvezdy-avto-maktab-production.up.railway.app,trizvezdi.webstorm.uz

# CORS (frontend manzillari)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tri-zvezdy-avto-maktab-production.up.railway.app,https://trizvezdi.webstorm.uz

# CSRF ishonchli originlar
CSRF_TRUSTED_ORIGINS=https://tri-zvezdy-avto-maktab-production.up.railway.app,https://trizvezdi.webstorm.uz

# Ma'lumotlar bazasi
# LOCALLARDA SQLite ishlatiladi (blank qoldiring):
# DATABASE_URL=

# PRODUCTIONDA PostgreSQL ga o'tish uchun (Railway Database plugin URL):
# DATABASE_URL=postgres://trizvezdy_user:trizvezdy_pass@host:5432/trizvezdy_db

# Superuser (seed_data buyrug'i uchun)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin12345
DJANGO_SUPERUSER_EMAIL=admin@trizvezdy.uz