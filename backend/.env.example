# Tri Zvezdy Avto Maktab — Backend sozlamalari

# Xavfsizlik
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (frontend manzillari)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ma'lumotlar bazasi
# LOCALLARDA SQLite ishlatiladi (blank qoldiring):
# DATABASE_URL=

# PRODUCTIONDA PostgreSQL ga o'tish uchun:
# DATABASE_URL=postgres://trizvezdy_user:trizvezdy_pass@127.0.0.1:5432/trizvezdy_db

# Superuser (seed_data buyrug'i uchun)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin12345
DJANGO_SUPERUSER_EMAIL=admin@trizvezdy.uz
